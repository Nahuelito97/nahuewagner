# --- Contact form (Resend) ---
# Set these in Netlify (Site settings → Environment variables → "Add a variable").
# They are server-side only (NOT VITE_ prefixed), used by netlify/edge-functions/contact.ts.

# Required: your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address. Defaults to "Portfolio <onboarding@resend.dev>"
# (Resend's test sender). Once you verify a domain in Resend, set this to
# e.g. "Portfolio <noreply@nahue.dev>".
RESEND_FROM=

# Optional: destination email (defaults to nahuel.wagner97@gmail.com).
RESEND_TO=

# --- Calendly (optional) ---
# Your Calendly booking URL. When set, a "Book a 30-min call" button appears
# in the Contact section. Format: https://calendly.com/<your-handle>
# This is a public URL so it's VITE_ prefixed (exposed to the client).
VITE_CALENDLY_URL=

# --- WhatsApp (optional) ---
# Your wa.me link with optional pre-filled message. When set, a "Chat on WhatsApp"
# button appears in the Contact section.
# Format: https://wa.me/549<area><number>?text=Hola%20Nahuel%2C%20vi%20tu%20portfolio...
VITE_WHATSAPP_URL=
