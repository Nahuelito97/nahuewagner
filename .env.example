# --- Contact form (Resend) ---
# Set these in Netlify (Site settings → Environment variables → "Add a variable").
# They are server-side only (NOT VITE_ prefixed), used by netlify/functions/contact.mts.

# Required: your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address. Defaults to "Portfolio <onboarding@resend.dev>"
# (Resend test sender, only delivers to your own account).
#
# Production value — REQUIRES verifying the domain in Resend first:
#   RESEND_FROM="Wagner Labs <no-reply@notify.wagnerlabs.dev>"
#
# Use a SUBDOMAIN (notify.) rather than the root domain: it isolates the
# reputation of transactional mail, so a spam complaint burns notify.* and
# not wagnerlabs.dev itself.
#
# Setup: Resend -> Domains -> Add Domain -> notify.wagnerlabs.dev, then add the
# SPF, DKIM and DMARC records it gives you to your DNS and wait for Verified.
# Sending from an unverified domain fails with 403.
RESEND_FROM=

# Optional: destination email (defaults to nahuel.wagner97@gmail.com).
RESEND_TO=

# --- Calendly (optional) ---
# Your Calendly booking URL. When set, a "Book a 30-min call" button appears
# in the Contact section. Format: https://calendly.com/<your-handle>
# This is a public URL so it's VITE_ prefixed (exposed to the client).
VITE_CALENDLY_URL=

# --- WhatsApp (optional) ---
# Your wa.me link with optional pre-filled message. When set, a "Chat on WhatsApp"
# button appears in the Contact section.
# Format: https://wa.me/549<area><number>?text=Hola%20Nahuel%2C%20vi%20tu%20portfolio...
VITE_WHATSAPP_URL=

# URL del panel admin (acceso oculto)
VITE_ADMIN_URL=http://localhost:5174
