{
  "name": "nahuewagner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "content:fetch": "node scripts/fetch-content.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/stamp-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "email": "email dev --dir src/emails --port 3030",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:compare": "node scripts/visual/compare.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.4.0",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@react-email/ui": "^6.11.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react-email": "^6.11.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
