{
  "name": "nahuewagner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:fetch": "node scripts/fetch-content.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/stamp-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "email": "email dev --dir src/emails --port 3030"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "framer-motion": "^12.0.0",
    "i18next": "^24.2.1",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-icons": "^5.4.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@netlify/functions": "^6.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "^6.9.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "netlify-cli": "^27.1.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react-email": "^6.9.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
