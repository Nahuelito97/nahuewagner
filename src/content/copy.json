      "es": "¿Hacés diseño de producto?"
    },
    "updatedAt": "2026-06-07T22:34:58.075Z"
  },
  {
    "key": "faq.items.equity.a",
    "namespace": "faq",
    "translations": {
      "en": "Usually no — I prefer paid work. Open to discussing for the right founder + project mix.",
      "es": "Usualmente no — prefiero trabajo pagado. Abierto a charlar para el founder + proyecto correcto."
    },
    "updatedAt": "2026-06-07T22:34:58.076Z"
  },
  {
    "key": "faq.items.equity.q",
    "namespace": "faq",
    "translations": {
      "en": "Equity instead of cash?",
      "es": "¿Equity en vez de plata?"
    },
    "updatedAt": "2026-06-07T22:34:58.076Z"
  },
  {
    "key": "faq.items.nda.a",
    "namespace": "faq",
    "translations": {
