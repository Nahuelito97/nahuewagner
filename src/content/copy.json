  {
    "key": "faq.items.bill.a",
    "namespace": "faq",
    "translations": {
      "en": "Fixed price for well-defined scope, hourly for ongoing or open-ended work. USD via Wise, Payoneer or local bank transfer.",
      "es": "Precio fijo para scope bien definido, por hora para trabajo en curso. USD por Wise, Payoneer o transferencia local."
    },
    "updatedAt": "2026-06-07T22:34:58.074Z"
  },
  {
    "key": "faq.items.bill.q",
    "namespace": "faq",
    "translations": {
      "en": "How do you bill?",
      "es": "¿Cómo facturás?"
    },
    "updatedAt": "2026-06-07T22:34:58.073Z"
  },
  {
    "key": "faq.items.design.a",
    "namespace": "faq",
    "translations": {
      "en": "I work with your designer if you have one. I can ship clean default UIs (like this site) but I won't replace a real product designer for complex products.",
      "es": "Trabajo con tu diseñador si lo tenés. Puedo armar UIs limpias (como este sitio) pero no reemplazo a un diseñador de producto para cosas complejas."
    },
    "updatedAt": "2026-06-07T22:34:58.076Z"
  },
  {
    "key": "faq.items.design.q",
    "namespace": "faq",
    "translations": {
